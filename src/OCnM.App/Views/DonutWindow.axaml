<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:OCnM.App.Controls"
        xmlns:vm="using:OCnM.App.ViewModels"
        x:Class="OCnM.App.Views.DonutWindow"
        x:DataType="vm:DonutViewModel"
        Title="Slotty"
        Width="440" Height="500"
        MinWidth="440" MaxWidth="440" MinHeight="500" MaxHeight="500"
        CanResize="False" CanMinimize="False" CanMaximize="False"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="False">
  <Window.Styles>
    <!-- Toast: slides up and fades in (decelerating); hidden toasts don't take clicks. -->
    <Style Selector="Border.toast">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="RenderTransform" Value="translateY(10px)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.toast.shown">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
      <Setter Property="RenderTransform" Value="translateY(0px)" />
    </Style>
    <Style Selector="Border.reducedMotion Border.toast">
      <Setter Property="Transitions" Value="{x:Null}" />
    </Style>

    <!-- Status icon + color per kind, so meaning never relies on color alone. -->
    <Style Selector="c|IconGlyph#ToastIcon">
      <Setter Property="Icon" Value="{x:Static c:DonutIcons.Info}" />
      <Setter Property="Foreground" Value="{DynamicResource OCnMAccent}" />
    </Style>
    <Style Selector="Border.toast.success c|IconGlyph#ToastIcon">
      <Setter Property="Icon" Value="{x:Static c:DonutIcons.CheckCircle}" />
      <Setter Property="Foreground" Value="{DynamicResource OCnMSuccess}" />
    </Style>
    <Style Selector="Border.toast.error c|IconGlyph#ToastIcon">
      <Setter Property="Icon" Value="{x:Static c:DonutIcons.ErrorCircle}" />
      <Setter Property="Foreground" Value="{DynamicResource OCnMError}" />
    </Style>
    <Style Selector="Border.toast.progress c|IconGlyph#ToastIcon">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.toast.error TextBlock.toastTitle">
      <Setter Property="Foreground" Value="{DynamicResource OCnMError}" />
    </Style>

    <Style Selector="TextBlock.overlayTitle">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Window.Styles>

  <Border x:Name="Frame" CornerRadius="28" BorderThickness="0">
    <Grid RowDefinitions="440,60">
      <Panel>
        <c:DonutMenu x:Name="Donut" Width="420" Height="420"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     AutomationProperties.Name="Folder slices"
                     AutomationProperties.HelpText="Arrow keys select a slice, Enter opens it, 1 to 9 open a slice directly, Menu key shows options"
                     Slices="{Binding DonutSlices}"
                     IdleTitle="{Binding IdleTitle}"
                     IdleSubtitle="{Binding IdleSubtitle}" />

        <ToggleButton Classes="corner" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                      IsChecked="{Binding IsPinned}"
                      AutomationProperties.Name="Pin the donut open"
                      ToolTip.Tip="Pin: keep the donut open while you drag files from another window">
          <c:IconGlyph Icon="{x:Static c:DonutIcons.Pin}" Width="16" Height="16" />
        </ToggleButton>
        <Button Classes="corner" Margin="12" HorizontalAlignment="Right" VerticalAlignment="Top"
                Command="{Binding OpenSettingsCommand}"
                AutomationProperties.Name="Settings" ToolTip.Tip="Settings">
          <c:IconGlyph Icon="{x:Static c:DonutIcons.Sliders}" Width="16" Height="16" />
        </Button>

        <!-- Scrim: isolates an open card from the busy ring behind it. -->
        <Ellipse Width="424" Height="424" Fill="{DynamicResource OCnMScrim}"
                 IsVisible="{Binding Overlay, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <ContentControl Name="OverlayHost" Content="{Binding Overlay}" HorizontalAlignment="Center" VerticalAlignment="Center">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vm:RenameOverlayViewModel">
              <Border Classes="card" Width="290">
                <StackPanel Spacing="12">
                  <TextBlock Classes="overlayTitle" Text="{Binding Title}" />
                  <StackPanel Spacing="6">
                    <TextBlock Classes="muted" FontSize="12" Text="Label" />
                    <TextBox Name="RenameBox" Text="{Binding Text}" PlaceholderText="{Binding Placeholder}"
                             AutomationProperties.Name="Slice label" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="Leave it empty to use the folder name." />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
                    <Button Content="Save" Classes="accent" Command="{Binding SaveCommand}" IsDefault="True" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
            <DataTemplate DataType="vm:ConflictOverlayViewModel">
              <Border Classes="card" Width="340">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <c:IconGlyph Icon="{x:Static c:DonutIcons.Warning}" Width="22" Height="22" VerticalAlignment="Top"
                                 Foreground="{DynamicResource OCnMWarning}" />
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock Classes="overlayTitle" Text="{Binding Title}" />
                      <TextBlock Classes="muted" FontSize="13" Text="{Binding Message}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                  <CheckBox Content="Do this for all remaining conflicts" IsChecked="{Binding ApplyToAll}" />
                  <WrapPanel HorizontalAlignment="Right" ItemSpacing="6" LineSpacing="6">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" />
                    <Button Content="Skip" Command="{Binding SkipCommand}" />
                    <Button Content="Replace" Command="{Binding ReplaceCommand}" IsVisible="{Binding CanReplace}"
                            ToolTip.Tip="The old file is kept until the operation can no longer be undone" />
                    <Button Content="Keep both" Classes="accent" Command="{Binding KeepBothCommand}" IsDefault="True" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </Panel>

      <Border Name="Toast" Grid.Row="1" Margin="22,2,22,8" Padding="12,6,6,6"
              Classes="card toast"
              Classes.shown="{Binding Toast.IsVisible}"
              Classes.success="{Binding Toast.IsSuccess}"
              Classes.error="{Binding Toast.IsError}"
              Classes.progress="{Binding Toast.IsProgress}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <c:IconGlyph Name="ToastIcon" Width="20" Height="20" VerticalAlignment="Center" StrokeWidth="2" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Classes="toastTitle" Text="{Binding Toast.Message}" FontWeight="SemiBold" FontSize="13"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="muted" Text="{Binding Toast.Detail}" IsVisible="{Binding Toast.HasDetail}"
                       FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Toast.Detail}" />
            <ProgressBar Value="{Binding Toast.Progress}" Minimum="0" Maximum="1"
                         IsVisible="{Binding Toast.IsProgress}" Height="4" MinHeight="4" Margin="0,3,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button Classes="link accent" Content="Undo" IsVisible="{Binding Toast.CanUndo}" Command="{Binding UndoCommand}"
                    AutomationProperties.Name="Undo the last drop" />
            <Button Classes="link" Content="Cancel" IsVisible="{Binding Toast.CanCancel}" Command="{Binding CancelTransferCommand}"
                    AutomationProperties.Name="Cancel the transfer" />
            <Button Classes="ghost" IsVisible="{Binding !Toast.IsProgress}" Command="{Binding DismissToastCommand}"
                    AutomationProperties.Name="Dismiss" ToolTip.Tip="Dismiss">
              <c:IconGlyph Icon="{x:Static c:DonutIcons.Cross}" Width="12" Height="12" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
