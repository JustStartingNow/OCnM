<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OCnM.App.Controls"
             xmlns:vm="using:OCnM.App.ViewModels"
             x:Class="OCnM.App.Controls.ColorEditorView"
             x:DataType="vm:ColorEditorViewModel">
  <UserControl.Styles>
    <Style Selector="TextBox.invalid">
      <Setter Property="BorderBrush" Value="{DynamicResource OCnMError}" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource OCnMMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.readout">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource OCnMMuted}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="12" Width="252">
    <!-- Preview and hex -->
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
      <Ellipse Width="32" Height="32" Fill="{Binding PreviewBrush}" Stroke="{DynamicResource OCnMStroke}" StrokeThickness="1.5" />
      <TextBox Grid.Column="1" Text="{Binding Hex}" PlaceholderText="#RRGGBB, empty = default"
               Classes.invalid="{Binding IsInvalid}" AutomationProperties.Name="Hex color" VerticalAlignment="Center" />
    </Grid>
    <TextBlock Foreground="{DynamicResource OCnMError}" FontSize="12" Text="Use a hex color like #3366FF."
               IsVisible="{Binding IsInvalid}" />

    <!-- Palette -->
    <ItemsControl ItemsSource="{Binding Presets}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="vm:ColorPreset">
          <Button Classes="ghost" Command="{Binding SelectCommand}" ToolTip.Tip="{Binding Name}"
                  AutomationProperties.Name="{Binding Name}" Width="36" Height="36" Padding="0">
            <Ellipse Width="22" Height="22" Fill="{Binding Brush}" Stroke="{DynamicResource OCnMStroke}" StrokeThickness="1.5" />
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Sliders -->
    <Grid ColumnDefinitions="64,*,38" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
      <TextBlock Classes="caption" Text="Hue" />
      <c:GradientSlider Grid.Column="1" Maximum="360" Value="{Binding Hue}" TrackBrush="{Binding HueTrack}"
                        AutomationProperties.Name="Hue" LargeChange="15" />
      <TextBlock Grid.Column="2" Classes="readout" Text="{Binding Hue, StringFormat={}{0:0}°}" />

      <TextBlock Grid.Row="1" Classes="caption" Text="Saturation" />
      <c:GradientSlider Grid.Row="1" Grid.Column="1" Maximum="100" Value="{Binding Saturation}" TrackBrush="{Binding SaturationTrack}"
                        AutomationProperties.Name="Saturation" />
      <TextBlock Grid.Row="1" Grid.Column="2" Classes="readout" Text="{Binding Saturation, StringFormat={}{0:0}%}" />

      <TextBlock Grid.Row="2" Classes="caption" Text="Brightness" />
      <c:GradientSlider Grid.Row="2" Grid.Column="1" Maximum="100" Value="{Binding Brightness}" TrackBrush="{Binding BrightnessTrack}"
                        AutomationProperties.Name="Brightness" />
      <TextBlock Grid.Row="2" Grid.Column="2" Classes="readout" Text="{Binding Brightness, StringFormat={}{0:0}%}" />
    </Grid>
  </StackPanel>
</UserControl>
