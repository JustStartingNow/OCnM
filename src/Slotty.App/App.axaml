<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Slotty.App.App"
             Name="Slotty"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Semantic tokens. Text pairs keep at least 4.5:1 against the card they sit on in both themes. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="SlottyWindowBg" Color="#F4F4F8" />
          <SolidColorBrush x:Key="SlottySurface" Color="#F6F6FA" />
          <SolidColorBrush x:Key="SlottyCard" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SlottyCardHover" Color="#F1F1F7" />
          <SolidColorBrush x:Key="SlottyStroke" Color="#DCDCE6" />
          <SolidColorBrush x:Key="SlottyText" Color="#1B1B24" />
          <SolidColorBrush x:Key="SlottyMuted" Color="#5D5D6E" />
          <SolidColorBrush x:Key="SlottyAccent" Color="#5254D0" />
          <SolidColorBrush x:Key="SlottyAccentSoft" Color="#1F5254D0" />
          <SolidColorBrush x:Key="SlottyError" Color="#B91C1C" />
          <SolidColorBrush x:Key="SlottySuccess" Color="#15803D" />
          <SolidColorBrush x:Key="SlottyWarning" Color="#B45309" />
          <SolidColorBrush x:Key="SlottyScrim" Color="#B3F6F6FA" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="SlottyWindowBg" Color="#16161D" />
          <SolidColorBrush x:Key="SlottySurface" Color="#1E1E26" />
          <SolidColorBrush x:Key="SlottyCard" Color="#22222C" />
          <SolidColorBrush x:Key="SlottyCardHover" Color="#2A2A36" />
          <SolidColorBrush x:Key="SlottyStroke" Color="#363644" />
          <SolidColorBrush x:Key="SlottyText" Color="#ECECF3" />
          <SolidColorBrush x:Key="SlottyMuted" Color="#A3A3B5" />
          <SolidColorBrush x:Key="SlottyAccent" Color="#8B8BF5" />
          <SolidColorBrush x:Key="SlottyAccentSoft" Color="#338B8BF5" />
          <SolidColorBrush x:Key="SlottyError" Color="#F87171" />
          <SolidColorBrush x:Key="SlottySuccess" Color="#4ADE80" />
          <SolidColorBrush x:Key="SlottyWarning" Color="#F5A524" />
          <SolidColorBrush x:Key="SlottyScrim" Color="#B31E1E26" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <!-- Fluent's own accent (checkboxes, accent buttons, focus) follows Slotty's accent. -->
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#5254D0" RegionColor="#F4F4F8" />
        <ColorPaletteResources x:Key="Dark" Accent="#7B7BEA" RegionColor="#16161D" />
      </FluentTheme.Palettes>
    </FluentTheme>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SlottyCard}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SlottyStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="BoxShadow" Value="0 6 24 0 #40000000" />
    </Style>

    <!-- Round icon buttons in the donut corners: 36px target, visible hover/pressed/focus states. -->
    <Style Selector="Button.corner, ToggleButton.corner">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Background" Value="{DynamicResource SlottyCard}" />
      <Setter Property="Foreground" Value="{DynamicResource SlottyMuted}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SlottyStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ToggleButton.corner:checked">
      <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.link">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="7" />
      <Setter Property="MinWidth" Value="32" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource SlottyMuted}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.ghost:disabled">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource SlottyMuted}" />
    </Style>
  </Application.Styles>
</Application>
